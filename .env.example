# Copy this file to ".env" and fill in real values for local runs.
# In GitHub Actions, these same names are set as repository secrets
# instead (Settings -> Secrets and variables -> Actions) and injected as
# real environment variables — .env itself is never committed.

WOOT_API_KEY=
BESTBUY_API_KEY=

# Supabase project — see deal_bot/config.py (and the storage modules) for
# the tables this expects (seen_deals, price_history, run_log, posted_deals,
# guild_destinations, guild_deal_posts). SUPABASE_SECRET_KEY is the preferred
# sb_secret_... server key; SUPABASE_SERVICE_KEY is the legacy service_role
# JWT, still honored as a fallback. When both are set, SUPABASE_SECRET_KEY wins.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=

# Discord webhooks
WOOT_WEBHOOK_URL=
BESTBUY_WEBHOOK_URL=
SHOPIFY_WEBHOOK_URL=
PRIVATE_WEBHOOK_URL=
DIGEST_WEBHOOK_URL=
RUN_LOG_WEBHOOK_URL=
SHADOW_CLASSIFIER_WEBHOOK_URL=
SHADOW_QUALITY_SCORER_WEBHOOK_URL=
SHADOW_CATEGORIZER_WEBHOOK_URL=

# Native Discord bot (always-on service). `python -m deal_bot --bot`
DISCORD_BOT_TOKEN=
DISCORD_BOT_OWNER_ID=
BOT_RUN_INTERVAL_SECONDS=14400

# Shopify — public /products.json storefronts need no API key. SHOPIFY_STORES
# is an optional JSON list overriding the built-in defaults, e.g.:
#   [{"name":"KBDfans","base_url":"https://kbdfans.com","collection_handles":[]}]
# Leave blank to use DEFAULT_SHOPIFY_STORES. The throttle/collection-count
# values are tuning knobs (repo Variables in CI). SHOPIFY_WEBHOOK_URL is a
# Discord webhook URL, same shape as the Woot/Best Buy ones.
SHOPIFY_STORES=
SHOPIFY_THROTTLE_MIN=2
SHOPIFY_THROTTLE_MAX=5
SHOPIFY_MAX_COLLECTIONS_PER_STORE=1

# Bluesky (optional — leave blank to skip Bluesky posting entirely)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# OpenRouter (optional — leave OPENROUTER_API_KEY blank to skip AI captions
# entirely and always use the plain template)
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SPEC_EXTRACTION_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SPEC_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_QUALITY_SCORER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_QUALITY_SCORER_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_WEEKLY_DIGEST_MODEL=openai/gpt-5.6-luna
OPENROUTER_WEEKLY_DIGEST_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_CATEGORIZER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_CATEGORIZER_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# vet_amazon_deal.py — standalone manual-Amazon-deal vetting assistant,
# not part of the deal_bot cron pipeline. Reuses OPENROUTER_API_KEY
# above; these two are optional overrides of its model defaults.
OPENROUTER_AMAZON_TEXT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_AMAZON_VISION_MODEL=google/gemini-2.5-flash

# Deal-quality thresholds (all optional — sensible defaults are baked in
# if omitted, see deal_bot/config.py)
MIN_DISCOUNT_PERCENT=20
MIN_DOLLAR_SAVINGS=10
BLUESKY_MIN_DISCOUNT_PERCENT=50
BLUESKY_MAX_POSTS_PER_RUN=2
PRICE_HISTORY_MIN_DAYS=3
PRICE_HISTORY_TOLERANCE_PERCENT=5
MIN_QUALITY_SCORE=6

# Desirability classifier mode: "shadow" (report to the shadow channel,
# gate nothing — the default) or "gate" (DROP verdicts are withheld before
# posting). Only flip to "gate" after reviewing the shadow channel over
# enough real runs. In GitHub Actions this is a repository Variable.
CLASSIFIER_MODE=shadow
